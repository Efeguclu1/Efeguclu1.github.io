---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  profile,
  education,
  experience,
  projects,
  skills,
  activities,
  languages,
} from "../data/resume";

const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, "");
---

<BaseLayout
  title="Efe Güçlü — CV"
  description="Curriculum Vitae of Efe Güçlü (Computer Science & Engineering)."
>
  <div class="page">
    <p class="cmd">cat cv.md</p>
    <h1>
      <span class="screen-only">Curriculum Vitae</span>
      <span class="print-only">{profile.name}</span>
    </h1>

    <div class="contact">
      <span>{profile.location}</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href={profile.github} target="_blank" rel="noreferrer">
        <span class="screen-only">github</span>
        <span class="print-only">{bare(profile.github)}</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noreferrer">
        <span class="screen-only">linkedin</span>
        <span class="print-only">{bare(profile.linkedin)}</span>
      </a>
    </div>

    <section class="section">
      <h2 class="section-title">education</h2>
      {education.map((item) => (
        <div class="entry">
          <p class="entry-date"><span>{item.date}</span><span>{item.place}</span></p>
          <div>
            <h3>{item.school}</h3>
            <p class="entry-role">{item.detail}</p>
            <ul class="bullets">
              {item.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </section>

    <section class="section">
      <h2 class="section-title">work experience</h2>
      {experience.map((job) => (
        <div class="entry">
          <p class="entry-date"><span>{job.date}</span></p>
          <div>
            <h3>
              {job.org}
              {job.current && <span class="badge">now</span>}
            </h3>
            <p class="entry-role">{job.role}</p>
            {job.summary && <p class="summary">{job.summary}</p>}
            <ul class="bullets">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </section>

    <section class="section">
      <h2 class="section-title">projects</h2>
      {projects.map((p) => (
        <div class="entry">
          <p class="entry-date"><span>{p.date}</span></p>
          <div>
            <h3><a href={`/projects#${p.slug}`}>{p.name}</a></h3>
            {p.label && <p class="entry-role">{p.label}</p>}
            <p class="summary">{p.summary}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="section">
      <h2 class="section-title">technical skills</h2>
      {skills.map((skill) => (
        <div class="entry compact">
          <p class="entry-date"><span>{skill.group}</span></p>
          <ul class="tags">
            {skill.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="section">
      <h2 class="section-title">extracurricular activities</h2>
      {activities.map((item) => (
        <div class="entry">
          <p class="entry-date"><span>{item.date}</span></p>
          <div>
            <h3>{item.org}</h3>
            <p class="entry-role">{item.role}</p>
            <ul class="bullets">
              {item.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </section>

    <section class="section">
      <h2 class="section-title">languages</h2>
      {languages.map((lang) => (
        <div class="entry compact">
          <p class="entry-date"><span>{lang.name}</span></p>
          <p class="level">{lang.level}</p>
        </div>
      ))}
    </section>
  </div>

  <style>
    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 24px;
      margin-top: 20px;
      color: var(--color-text-muted);
    }

    .summary {
      color: var(--color-text-muted);
      max-width: 68ch;
      margin-top: 8px;
    }

    h3 a {
      color: var(--color-text);
    }

    h3 a:hover {
      color: var(--color-accent-hover);
    }

    .entry.compact {
      padding: 10px 0;
      align-items: center;
    }

    .entry.compact .entry-date {
      color: var(--color-text-muted);
      padding-top: 0;
    }

    .level {
      color: var(--color-text);
    }

    @media print {
      .contact {
        gap: 0 1.2rem;
        margin-top: 4pt;
      }

      .summary {
        max-width: none;
        margin-top: 2pt;
      }

      .entry.compact {
        padding: 2pt 0;
      }
    }
  </style>
</BaseLayout>
