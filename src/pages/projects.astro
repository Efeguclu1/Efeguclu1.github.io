---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/resume";
---

<BaseLayout
  title="Efe Güçlü — Projects"
  description="Selected projects in networking, cloud infrastructure, and machine learning."
>
  <div class="page">
    <p class="cmd">ls -l projects/</p>
    <h1>Projects</h1>
    <p class="lede">
      A selection of course and engineering projects. Focus on clear problems, practical implementation, and measurable validation.
    </p>

    <div class="list">
      {projects.map((p, i) => (
        <article class="project" id={p.slug}>
          <span class="index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <div class="project-header">
              <h2>{p.name}</h2>
              <span class="date">{p.date}</span>
            </div>
            {p.label && <p class="label">{p.label}</p>}
            <p class="summary">{p.summary}</p>

            <ul class="bullets">
              {p.points.map((point) => <li>{point}</li>)}
            </ul>

            <ul class="tags">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>

  <style>
    .list {
      margin-top: 40px;
    }

    .project {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0 16px;
      padding: 32px 0;
      border-top: 1px dashed var(--color-border);
    }

    .project:target h2 {
      color: var(--color-accent-hover);
      text-shadow: 0 0 12px var(--color-glow);
    }

    .index {
      font-family: var(--font-pixel);
      font-size: 0.8rem;
      color: var(--color-text-subtle);
      padding-top: 6px;
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
    }

    h2 {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--color-accent);
      text-wrap: balance;
    }

    .date {
      color: var(--color-text-subtle);
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .label {
      color: var(--color-text-subtle);
      font-size: 0.85rem;
      margin-top: 2px;
    }

    .summary {
      max-width: 68ch;
      margin-top: 12px;
    }

    .tags {
      margin-top: 18px;
    }

    @media (max-width: 640px) {
      .project {
        grid-template-columns: minmax(0, 1fr);
      }
      .index {
        padding: 0 0 8px;
      }
      .project-header {
        flex-direction: column;
        gap: 2px;
      }
    }
  </style>
</BaseLayout>
